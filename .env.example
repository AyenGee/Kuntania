# Copy to .env (local) or set in the Vercel dashboard (production). Never commit real values.

# --- Core -------------------------------------------------------------------
# Public base URL, no trailing slash. Used for canonical URLs, emails and PayFast callbacks.
SITE_URL=http://localhost:3000

# PostgreSQL connection string used by the running app.
#
# SUPABASE (recommended): Dashboard > Connect > "Transaction pooler" (port 6543). It looks like
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
# The "?sslmode=require&uselibpqcompat=true" ending is REQUIRED (without it the connection fails
# with a certificate error). URL-encode special characters in the password (@ -> %40, etc.).
# Use the POOLER string, not the "Direct connection": that host is IPv6-only on most plans, so
# Vercel and many home networks cannot reach it.
#
# Local Docker alternative (matches docker-compose.yml):
#   postgresql://kuntania:kuntania@localhost:5432/kuntania
DATABASE_URL=postgresql://kuntania:kuntania@localhost:5432/kuntania

# OPTIONAL: connection used only by `prisma migrate` (npm run db:migrate / db:deploy).
# SUPABASE: Dashboard > Connect > "Session pooler" (port 5432, same host as above, IPv4-friendly):
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# The transaction pooler (6543) can't run migrations reliably, which is why this is separate.
# Leave blank for a plain local database.
DIRECT_DATABASE_URL=

# 32+ character random string used to sign the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret for cron-style routes (e.g. cancelling stale pending orders). Send as
# "Authorization: Bearer <value>". Generate like SESSION_SECRET.
CRON_SECRET=

# --- Business flags ---------------------------------------------------------
# true if the business is VAT registered (prices are VAT-inclusive, 15%).
VAT_REGISTERED=false

# Set to true ONLY once the client has approved the policy pages. In production the
# "DRAFT" banner on policy pages is hidden only when this is true.
POLICIES_APPROVED=false

# --- PayFast ----------------------------------------------------------------
# PayFast calls SITE_URL/api/payments/payfast/notify after each payment, so SITE_URL must be
# publicly reachable (a Vercel preview URL or a tunnel such as ngrok; not http://localhost).
# Use PayFast sandbox credentials while PAYFAST_MODE=sandbox.
# sandbox | live
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Must match the passphrase set in the PayFast dashboard. Required in live mode.
PAYFAST_PASSPHRASE=
# TEST ONLY (used by the Playwright end-to-end test). Replaces PayFast's validation URL and is
# ignored unless PAYFAST_MODE=sandbox. Leave blank.
PAYFAST_VALIDATE_URL=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# e.g. "Kunta Nia <orders@example.co.za>"
EMAIL_FROM=
# Where new-order alerts and contact messages are sent.
OWNER_EMAIL=

# --- Analytics (optional, cookieless) --------------------------------------
# Leave both blank to load no analytics at all.
# Plausible: ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js  ANALYTICS_DOMAIN=yourdomain.co.za
# Umami:     ANALYTICS_SCRIPT_URL=https://<umami-host>/script.js     ANALYTICS_WEBSITE_ID=<website id>
# (Only the script's own host is allowed by the Content Security Policy.)
ANALYTICS_SCRIPT_URL=
ANALYTICS_DOMAIN=
ANALYTICS_WEBSITE_ID=

# --- Seed / admin bootstrap -------------------------------------------------
# Used by `npm run db:seed` to create the first admin user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner
